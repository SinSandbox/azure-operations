{
  "name": "demo-allowed-vm-skus",
  "properties": {
    "displayName": "Demo environment - allowed low-cost virtual machine SKUs",
    "description": "Restricts virtual machine deployments to a defined list of small, low-cost SKUs (for example B-series burstable and Dsv3/Dv3 small sizes) and denies premium, GPU, or large compute SKUs. Implements TR-002 (Allowed resource model and SKU control).",
    "policyType": "Custom",
    "mode": "Indexed",
    "metadata": {
      "version": "1.0.0"
    },
    "parameters": {
      "effect": {
        "type": "String",
        "metadata": {
          "displayName": "Effect",
          "description": "Enable or disable execution of this policy"
        },
        "allowedValues": ["Deny", "Audit", "Disabled"],
        "defaultValue": "Deny"
      },
      "allowedSkus": {
        "type": "Array",
        "metadata": {
          "displayName": "Allowed VM SKUs",
          "description": "Array of virtual machine size names permitted in the demo subscription."
        },
        "defaultValue": [
          "Standard_B1s",
          "Standard_B1ms",
          "Standard_B2s",
          "Standard_B2ms",
          "Standard_B4ms",
          "Standard_D2s_v3",
          "Standard_D2s_v5",
          "Standard_D4s_v3"
        ]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          {
            "field": "type",
            "equals": "Microsoft.Compute/virtualMachines"
          },
          {
            "not": {
              "field": "Microsoft.Compute/virtualMachines/sku.name",
              "in": "[parameters('allowedSkus')]"
            }
          }
        ]
      },
      "then": {
        "effect": "[parameters('effect')]"
      }
    }
  }
}
